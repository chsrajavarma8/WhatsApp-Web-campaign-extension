{
  "manifest_version": 3,
  "name": "Personalized Campaign Sender for WhatsApp Web",
  "short_name": "Campaign Sender",
  "version": "1.1.0",
  "description": "Send personalized messages to consenting contacts from a CSV file using WhatsApp Web. All data stays in your browser.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://web.whatsapp.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Campaign Sender",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["wa-selectors.js", "wa-dom.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
